# Server
PORT=3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reading_tracker
DB_USER=root
DB_PASS=

# CORS — frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5000

# Open Library
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org
OPENLIBRARY_TIMEOUT_MS=8000
OPENLIBRARY_USER_AGENT=MiniReadingTracker/1.0 (contact@example.com)

# Search suggestions keyword (shown on home when no query)
SUGGESTION_QUERY=classic literature
